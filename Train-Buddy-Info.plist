<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Train Buddy</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>cdwifi.cz</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<false/>
			</dict>
		</dict>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Train Buddy connects to your train’s onboard portal to show its journey and live travel information.</string>
</dict>
</plist>
